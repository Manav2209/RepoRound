{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "VOICE_OUTBOX_DIR",
    "LANGFUSE_BASE_URL",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "GITHUB_TOKEN",
    "INTERVIEW_DURATION_MINUTES",
    "RECONNECT_WINDOW_SECONDS",
    "FALKORDB_HOST",
    "FALKORDB_PORT",
    "FALKORDB_GRAPH",
    "FALKORDB_TEST_HOST",
    "FALKORDB_TEST_PORT",
    "FALKORDB_TEST_GRAPH",
    "RUN_DB_TESTS",
    "BULLMQ_REDIS_URL",
    "EVALUATION_WORKER_CONCURRENCY",
    "BACKEND_URL"
  ],
  "tasks": {
    "@repo/db#build": {
      "outputs": ["generated/**"]
    },
    "@repo/db#check-types": {
      "dependsOn": ["build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["BACKEND_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "NODE_ENV",
        "E2E_BACKEND_URL",
        "E2E_INTERVIEW_ID",
        "E2E_SESSION_TOKEN",
        "E2E_SESSION_ROOM",
        "E2E_SERVER_URL",
        "BACKEND_URL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "agent:start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "LIVEKIT_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "LIVEKIT_AGENT_NAME",
        "ROOM_NAME",
        "DEEPGRAM_API_KEY",
        "DEEPGRAM_MODEL",
        "DEEPGRAM_TTS_MODEL",
        "DEEPGRAM_UTTERANCE_END_MS",
        "AI_ROUTER_BASE_URL",
        "AI_ROUTER_API_KEY",
        "AI_ROUTER_MODEL",
        "LLM_TEMPERATURE",
        "SARVAM_API_KEY",
        "SARVAM_MODEL",
        "SARVAM_SPEAKER",
        "SARVAM_TARGET_LANGUAGE",
        "AGENT_LANGUAGE",
        "BACKEND_BASE_URL",
        "INTERNAL_API_TOKEN"
      ]
    },
    "backend:start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "AI_ROUTER_BASE_URL",
        "AI_ROUTER_API_KEY",
        "AI_ROUTER_MODEL",
        "LLM_TEMPERATURE",
        "LIVEKIT_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "INTERNAL_API_TOKEN",
        "CORS_ALLOWED_ORIGINS"
      ],
      "envMode": "loose"
    },
    "evaluation-worker:start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "BULLMQ_REDIS_URL",
        "EVALUATION_WORKER_CONCURRENCY",
        "AI_ROUTER_BASE_URL",
        "AI_ROUTER_API_KEY",
        "AI_ROUTER_MODEL",
        "LLM_TEMPERATURE",
        "LANGFUSE_BASE_URL",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "VOICE_OUTBOX_DIR"
      ],
      "envMode": "loose"
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["BACKEND_URL"]
    }
  }
}
