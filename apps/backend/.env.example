# Backend server
PORT=8080

# Set this to your managed PostgreSQL connection URL for the root Docker stack.
# The local development default below assumes PostgreSQL is running on localhost.
DATABASE_URL=postgresql://ai_interview:ai_interview@localhost:5432/ai_interview

# LLM (AI Router OpenAI-compatible endpoint) - same router as the voice agent
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=
LLM_TEMPERATURE=

# LiveKit (server creds for room/session creation + candidate tokens)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret between backend and voice agent (agent control/data path)
INTERNAL_API_TOKEN=

# Optional outside Docker. EC2 deploy generates and shares this with Caddy only.
# 64 lowercase hex characters; never accept arbitrary X-Forwarded-For headers.
# TRUSTED_PROXY_TOKEN=

# Comma-separated origins allowed to call the HTTP API (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Better Auth. BETTER_AUTH_URL is the public app origin, not the backend port.
# Generate the secret with: openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
AUTH_SESSION_DAYS=7
# Leave unset to derive secure cookies from an https BETTER_AUTH_URL.
# AUTH_COOKIE_SECURE=true
# AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Transactional email (required in production). Verification and password
# reset links are logged instead of sent when these are unset locally.
RESEND_API_KEY=
AUTH_EMAIL_FROM=RepoRound <auth@example.com>
AUTH_EMAIL_REPLY_TO=

# Optional OAuth providers. Set both values for a provider to enable it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Clock starts when the voice session is allocated and survives reconnects.
# System-design interviews use INTERVIEW_DURATION_MINUTES; repository interviews
# target 10-15 minutes with GITHUB_INTERVIEW_DURATION_MINUTES.
INTERVIEW_DURATION_MINUTES=30
GITHUB_INTERVIEW_DURATION_MINUTES=15
RECONNECT_WINDOW_SECONDS=300

# FalkorDB reasoning graph for system design interviews.
# Use a port distinct from the BullMQ Redis instance.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=ai_interviewer

# BullMQ evaluation queue (dedicated Redis, maxmemory-policy noeviction).
# Keep this port distinct from FALKORDB_PORT.
BULLMQ_REDIS_URL=redis://localhost:6380
EVALUATION_WORKER_CONCURRENCY=1

# Optional authenticated GitHub API requests (leave unset to use public access).
# GITHUB_TOKEN=

# Optional Langfuse OTLP tracing. Omit these variables to keep traces local.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
