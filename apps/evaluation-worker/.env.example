# Evaluation worker — consumes the BullMQ `evaluate` queue.
# Must share DATABASE_URL and BULLMQ_REDIS_URL with apps/backend.

DATABASE_URL=postgresql://ai_interview:ai_interview@localhost:5432/ai_interview

# LLM (AI Router OpenAI-compatible endpoint) - same router as the backend.
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=
LLM_TEMPERATURE=

# BullMQ evaluation queue (dedicated Redis, maxmemory-policy noeviction).
# Keep this port distinct from FALKORDB_PORT.
BULLMQ_REDIS_URL=redis://localhost:6380
EVALUATION_WORKER_CONCURRENCY=1

# Optional Langfuse OTLP tracing. Omit these variables to keep traces local.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
