generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InterviewStatus {
  created
  analyzing
  ready
  active
  completing
  completed
  failed
  evaluation_failed
}

enum InterviewMode {
  GITHUB
  SYSTEM_DESIGN
}

enum DesignGraphStatus {
  BUILDING
  READY
  FAILED
}

enum SessionStatus {
  created
  active
  completed
  failed
}

enum TurnRole {
  user
  assistant
}

model Interview {
  id            String          @id @default(cuid())
  mode          InterviewMode   @default(GITHUB)
  githubUrl     String?
  owner         String?
  name          String?
  systemDesignProblemId String?
  status        InterviewStatus @default(created)
  error         String?
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  evaluationLeaseUntil DateTime?
  interviewPlan InterviewPlan?
  sessions      InterviewSession[]
  turns         ConversationTurn[]
  events        RealtimeEvent[]
  evaluation    Evaluation?
  runtime       InterviewRuntime?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledge     RepositoryKnowledge?
  domainEvents  InterviewEvent[]
  jobs          InterviewJob[]
  designSubmissions SystemDesignSubmission[]
  memoryProjection InterviewMemoryProjection?

  @@index([githubUrl])
  @@index([mode, status])
  @@index([userId])
}

model SystemDesignSubmission {
  id           String            @id @default(cuid())
  interviewId  String
  interview    Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  revision     Int
  requestId    String            @unique
  snapshot     Json
  snapshotHash String
  graphStatus  DesignGraphStatus @default(BUILDING)
  graphError   String?
  createdAt    DateTime          @default(now())
  readyAt      DateTime?

  @@unique([interviewId, revision])
  @@index([interviewId, graphStatus])
}

model InterviewRuntime {
  interviewId String    @id
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  version     Int       @default(0)
  data        Json
  deadlineAt  DateTime
  updatedAt   DateTime  @updatedAt
  leaseToken  String?
  leaseUntil  DateTime?
}

model InterviewPlan {
  id          String   @id @default(cuid())
  interviewId String   @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role        String
  difficulty  String
  topics      Json
  objectives  Json?
}

model InterviewSession {
  id          String        @id @default(cuid())
  interviewId String
  interview   Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  roomName    String        @unique
  serverUrl   String
  status      SessionStatus @default(created)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime      @default(now())
  turns       ConversationTurn[]
  events      RealtimeEvent[]
  disconnectedAt DateTime?
  heartbeatAt DateTime?
  dispatchLeaseUntil DateTime?
  dispatchLeaseToken String?

  @@index([interviewId])
}

model ConversationTurn {
  id          String   @id
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sessionId   String
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnIndex   Int
  role        TurnRole
  text        String
  createdAt   DateTime @default(now())
  completedAt DateTime?
  questionId  String?
  analysisStatus String @default("pending")
  analysisError String?

  @@index([interviewId])
  @@index([sessionId])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  interviews    Interview[]
  reports       Report[]
}

model Report {
  id          String   @id @default(cuid())
  interviewId String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        InterviewMode
  title       String
  score       Int?
  dimensions  Json
  strengths   String[]
  weaknesses  String[]
  feedback    String
  evidence    Json?
  coverage    Json?
  summary     Json
  completedAt DateTime
  createdAt   DateTime @default(now())

  @@index([userId, completedAt])
}

// Deliberately independent of Interview so an interrupted graph delete can retry.
model InterviewCleanup {
  interviewId String   @id
  status      String   @default("pending")
  attempts    Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, updatedAt])
}

model InterviewMemoryProjection {
  interviewId String    @id
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  version     Int
  projectedVersion Int @default(0)
  updatedAt   DateTime  @updatedAt

  @@index([version, projectedVersion])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RepositoryKnowledge {
  interviewId String @id
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  commitSha String
  files Json
  symbols Json
  facts Json
}

model InterviewEvent {
  id String @id
  interviewId String
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  type String
  payload Json
  createdAt DateTime @default(now())
  exportedAt DateTime?
  @@index([interviewId, createdAt])
  @@index([exportedAt])
}

model InterviewJob {
  id String @id
  interviewId String
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  kind String
  key String @unique
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  runAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  error String?
  @@index([status, runAt])
}

model RateLimitBucket {
  id String @id
  count Int
  resetAt DateTime
  @@index([resetAt])
}

model RealtimeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sessionId   String
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String
  timestamp   DateTime
  payload     Json

  @@index([interviewId])
  @@index([sessionId])
}

model Evaluation {
  id          String   @id @default(cuid())
  interviewId String   @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  score       Int?
  dimensions  Json
  strengths   String[]
  weaknesses  String[]
  feedback    String
  evidence    Json?
  status      String   @default("completed")
  createdAt   DateTime @default(now())
}
