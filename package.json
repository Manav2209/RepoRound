{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "agent:start": "turbo run agent:start",
    "evaluation-worker:start": "turbo run evaluation-worker:start",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:validate": "bun run --cwd packages/db db:validate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:migrate:deploy": "bun run --cwd packages/db db:migrate:deploy",
    "db:migrate:status": "bun run --cwd packages/db db:migrate:status",
    "db:studio": "bun run --cwd packages/db db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
